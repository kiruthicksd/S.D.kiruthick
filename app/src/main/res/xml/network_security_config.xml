<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow local LAN HTTP connections for ESP32-CAM streams (e.g., 192.168.x.x) -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
